{
  "name": "indobase-js",
  "version": "2.97.1-canary.3",
  "description": "Isomorphic Javascript SDK for Indobase",
  "license": "MIT",
  "author": "Indobase",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cors": {
      "import": {
        "types": "./dist/cors.d.mts",
        "default": "./dist/cors.mjs"
      },
      "require": {
        "types": "./dist/cors.d.cts",
        "default": "./dist/cors.cjs"
      }
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@indobaseinc/auth-js": "workspace:*",
    "@indobaseinc/functions-js": "workspace:*",
    "@indobaseinc/postgrest-js": "workspace:*",
    "@indobaseinc/realtime-js": "workspace:*",
    "@indobaseinc/storage-js": "workspace:*"
  }
}
