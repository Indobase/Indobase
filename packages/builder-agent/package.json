{
  "name": "@indobase/builder-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Skills catalog + typed SDK for Indobase Builder CFOS agents and generated Vite apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./skills": "./src/skills/index.ts",
    "./abi": "./src/abi.ts",
    "./client": "./src/client.ts"
