{
  "name": "@indobaseinc/shared-types",
  "version": "0.1.84",
  "description": "Shared Types for Indobase",
  "license": "Copyright Indobase",
  "author": "Indobase",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Indobase/Indobase.git",
    "directory": "packages/indobase-shared-types"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./out/index.js",
