# Indobase Email deploy env (copy to .env on the host)

# Postgres
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_PREFIX=indobase_email
DB_NAME=indobase_email_system
DB_SSLMODE=disable

# App crypto + Studio SSO (must match Studio EMAIL_HANDOFF_SECRET / STUDIO_HANDOFF_SECRET, ≥32 chars)
SECRET_KEY=change-me-openssl-rand-base64-32
STUDIO_HANDOFF_SECRET=change-me-same-as-studio-email-handoff-secret-32chars
EMAIL_HANDOFF_SECRET=
STUDIO_PUBLIC_URL=https://studio.indobase.in
STUDIO_HANDOFF_ONLY=true

# Public URL (Traefik host)
API_ENDPOINT=https://email.indobase.in
EMAIL_HOST=email.indobase.in
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Required: SHA-pinned Hub image from CI (.github/workflows/docker-publish.yml)
# INDOBASE_EMAIL_IMAGE=roshanraghavander/indobase-email:<git-sha>
INDOBASE_EMAIL_IMAGE=roshanraghavander/indobase-email:REPLACE_WITH_GIT_SHA

ROOT_EMAIL=ops@indobase.in
ENVIRONMENT=production
SMTP_FROM_NAME=Indobase Email
