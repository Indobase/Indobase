# Indobase Email deploy env (copy to .env on the host)
# Docs: docs/INDOBASE-EMAIL.md (monorepo) — sending, SES Mumbai, DNS/DKIM

# Postgres
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_PREFIX=indobase_email
DB_NAME=indobase_email_system
DB_SSLMODE=disable

# App crypto + Studio SSO (must match Studio EMAIL_HANDOFF_SECRET / STUDIO_HANDOFF_SECRET, ≥32 chars)
SECRET_KEY=change-me-openssl-rand-base64-32
STUDIO_HANDOFF_SECRET=change-me-same-as-studio-email-handoff-secret-32chars
EMAIL_HANDOFF_SECRET=
STUDIO_PUBLIC_URL=https://studio.indobase.in
STUDIO_HANDOFF_ONLY=true

# Public URL (Traefik host)
API_ENDPOINT=https://email.indobase.in
EMAIL_HOST=email.indobase.in
# Traefik router rule. Vyom .249 serves staging + prod hosts from one deployment:
EMAIL_TRAEFIK_RULE=Host(`email.indobase.fun`) || Host(`email.indobase.in`)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Required: SHA-pinned Hub image from CI (.github/workflows/docker-publish.yml)
# INDOBASE_EMAIL_IMAGE=roshanraghavander/indobase-email:<git-sha>
INDOBASE_EMAIL_IMAGE=roshanraghavander/indobase-email:REPLACE_WITH_GIT_SHA

ROOT_EMAIL=ops@indobase.in
ENVIRONMENT=production
SMTP_FROM_NAME=Indobase Email

# =============================================================================
# System SMTP (app emails: invites, magic codes, circuit-breaker alerts)
# Recommended for India / DPDP: Amazon SES SMTP — ap-south-1 (Mumbai)
# =============================================================================
# /api/setup.status → smtp_configured:true when HOST+PORT+FROM_EMAIL are set
# (or SMTP_MAILER=console + FROM_EMAIL for log-only smoke — no real delivery).
#
# Uncomment and fill. Create SES SMTP credentials:
#   AWS Console → SES (Mumbai) → SMTP settings → Create SMTP credentials
# Also verify the FROM domain/identity in SES and publish SPF/DKIM/DMARC DNS.
# Never commit real secrets — paste only into the host .env.
#
# SMTP_MAILER=smtp
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=AKIA...ses-smtp-user...
# SMTP_PASSWORD=...
# SMTP_FROM_EMAIL=noreply@your-verified-domain.com
# SMTP_USE_TLS=true
# SMTP_EHLO_HOSTNAME=email.indobase.in
#
# Smoke without ESP (logs only):
# SMTP_MAILER=console
# SMTP_FROM_EMAIL=noreply@indobase.in

# =============================================================================
# Workspace campaigns (marketing / transactional) — NOT these env vars
# =============================================================================
# Studio → Marketing → Open Email → Settings → Integrations → Amazon SES
# (API access key + secret, region ap-south-1) or SMTP / Mailgun / Postmark /
# SparkPost / Mailjet / SendGrid. Set as Marketing and/or Transactional provider.
# See docs/INDOBASE-EMAIL.md
