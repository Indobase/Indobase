# Copy to .env and fill before `docker compose up -d`
# Never commit real secrets.

CALENDAR_HANDOFF_SECRET=
# openssl rand -base64 32
CALENDAR_NEXTAUTH_SECRET=
# openssl rand -base64 24  (32 bytes for AES)
CALENDAR_ENCRYPTION_KEY=

CALENDAR_POSTGRES_USER=indobase_calendar
CALENDAR_POSTGRES_PASSWORD=
CALENDAR_POSTGRES_DB=indobase_calendar

STUDIO_PUBLIC_URL=https://studio.indobase.in
CALENDAR_PUBLIC_URL=https://calendar.indobase.in
MEET_PUBLIC_URL=https://meet.indobase.in
CALENDAR_MEET_AUTO_ATTACH=1
# Optional but recommended for one-click Open Meet from Calendar (same as Meet bridge).
# MEET_HANDOFF_SECRET=
# STUDIO_HANDOFF_SECRET=

CALENDAR_IMAGE=calcom/cal.com:v6.2.0
CALENDAR_TRAEFIK_RULE=Host(`calendar.indobase.in`) || Host(`calendar.indobase.fun`)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

GIT_SHA=dev

# Optional: npx web-push generate-vapid-keys
CALENDAR_VAPID_PUBLIC_KEY=
CALENDAR_VAPID_PRIVATE_KEY=
