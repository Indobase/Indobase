# Copy to docker/deploy/.env on Vyom .249

DOMAINS_HANDOFF_SECRET=change-me-min-32-chars-shared-with-studio
STUDIO_PUBLIC_URL=https://studio.indobase.in
STUDIO_INTERNAL_URL=http://indobase-studio:8080
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Studio (same host) also needs:
# DOMAINS_HANDOFF_SECRET=<same value>
# INDOBASE_DOMAINS_URL=https://domains.indobase.in
# NAMECOM_* + RAZORPAY_* for registrar + checkout
