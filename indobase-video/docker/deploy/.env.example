# Shared with Studio VIDEO_HANDOFF_SECRET / STUDIO_HANDOFF_SECRET (>= 32 chars)
VIDEO_HANDOFF_SECRET=replace-with-shared-studio-handoff-secret-min-32-chars

# Canonical public URL (OIDC-style origin for cookies)
VIDEO_PUBLIC_URL=https://video.indobase.in
STUDIO_PUBLIC_URL=https://studio.indobase.in

# Optional: pin CI image instead of local build
# IMAGE=roshanraghavander/indobase-video:<git-sha>

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
VIDEO_TRAEFIK_RULE=Host(`video.indobase.in`) || Host(`video.indobase.fun`)
