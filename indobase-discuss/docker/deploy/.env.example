# Indobase Discuss — copy to .env and fill secrets (never commit .env)

MARIADB_ROOT_PASSWORD=change-me-mariadb-root
DISCUSS_ADMIN_PASSWORD=change-me-admin

# Shared with Studio (>= 32 chars). Same as STUDIO_HANDOFF_SECRET on control-plane.
DISCUSS_HANDOFF_SECRET=

STUDIO_PUBLIC_URL=https://studio.indobase.in
# STUDIO_PUBLIC_URL=https://studio.indobase.fun

DISCUSS_SITE_NAME=discuss.localhost
DISCUSS_VERSION=dev

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
DISCUSS_TRAEFIK_RULE=Host(`discuss.indobase.in`) || Host(`discuss.indobase.fun`)
