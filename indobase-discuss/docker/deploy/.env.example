# Indobase Discuss — copy to .env and fill secrets (never commit .env)

# Postgres (Mattermost)
POSTGRES_USER=mmuser
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mattermost
POSTGRES_IMAGE_TAG=15-alpine

# Mattermost image
MATTERMOST_IMAGE=mattermost-team-edition
MATTERMOST_IMAGE_TAG=10.5.2

# First-boot system admin (used by bootstrap to mint an API token for the bridge)
MATTERMOST_ADMIN_EMAIL=discuss-admin@indobase.local
MATTERMOST_ADMIN_USERNAME=ibdiscuss
MATTERMOST_ADMIN_PASSWORD=change-me-admin-long-password
# Optional override if you already created a personal access token:
# MATTERMOST_ADMIN_TOKEN=

# Shared with Studio (>= 32 chars). Same as STUDIO_HANDOFF_SECRET on control-plane.
DISCUSS_HANDOFF_SECRET=

STUDIO_PUBLIC_URL=https://studio.indobase.in
# STUDIO_PUBLIC_URL=https://studio.indobase.fun

DISCUSS_SITE_URL=https://discuss.indobase.in
# DISCUSS_SITE_URL=https://discuss.indobase.fun
DISCUSS_SUPPORT_EMAIL=support@indobase.in
DISCUSS_VERSION=dev
GIT_SHA=dev

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
DISCUSS_TRAEFIK_RULE=Host(`discuss.indobase.in`) || Host(`discuss.indobase.fun`)
