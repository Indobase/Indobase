# Shared with Studio ANALYTICS_HANDOFF_SECRET / STUDIO_HANDOFF_SECRET (>= 32 chars)
ANALYTICS_HANDOFF_SECRET=replace-with-shared-studio-handoff-secret-min-32-chars
STUDIO_HANDOFF_SECRET=
STUDIO_PUBLIC_URL=https://studio.indobase.in

# Public URL (also baked into client at build time)
BASE_URL=https://analytics.indobase.in

# Better Auth
BETTER_AUTH_SECRET=replace-with-random-64-char-secret
DISABLE_SIGNUP=true
DISABLE_TELEMETRY=true

# Databases (generate strong passwords)
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=replace-clickhouse-password
POSTGRES_DB=analytics
POSTGRES_USER=analytics
POSTGRES_PASSWORD=replace-postgres-password
REDIS_PASSWORD=replace-redis-password

# Optional
MAPBOX_TOKEN=
CLUSTER_WORKERS=2
LITE_DASHBOARD=
ANALYTICS_SITE_DOMAIN_SUFFIX=indobase.in

# Traefik
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Optional image overrides after CI
# BACKEND_IMAGE=roshanraghavander/indobase-analytics-backend:<sha>
# CLIENT_IMAGE=roshanraghavander/indobase-analytics-client:<sha>

# Sentry (Indobase org — project: analytics). Same DSN for Next client + Fastify API.
# NEXT_PUBLIC_SENTRY_DSN=https://...@o....ingest.us.sentry.io/...
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ENVIRONMENT=production
# SENTRY_ORG=indobase
# SENTRY_PROJECT=analytics
