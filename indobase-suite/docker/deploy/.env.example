# Copy to .env and fill before `docker compose up -d`

MARIADB_ROOT_PASSWORD=
SUITE_HANDOFF_SECRET=
SUITE_ADMIN_PASSWORD=changeme
SUITE_SITE_NAME=workspace.localhost

STUDIO_PUBLIC_URL=https://studio.indobase.in
INDOBASE_EMAIL_URL=https://email.indobase.in
INDOBASE_DESIGN_URL=https://design.indobase.in

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
SUITE_TRAEFIK_RULE=Host(`workspace.indobase.in`) || Host(`workspace.indobase.fun`)

SUITE_VERSION=dev
