# Copy to .env and fill before `docker compose up -d`
# Never commit real secrets.

SUITE_HANDOFF_SECRET=
DOCUMENT_JWT_SECRET=

STUDIO_PUBLIC_URL=https://studio.indobase.in
WORKSPACE_PUBLIC_URL=https://workspace.indobase.in
# Internal URL DocumentServer uses to fetch/callback into the bridge
BRIDGE_INTERNAL_URL=http://suite-bridge:8093
DOCUMENT_SERVER_PUBLIC_URL=https://workspace.indobase.in/ds

INDOBASE_EMAIL_URL=https://email.indobase.in
INDOBASE_DESIGN_URL=https://design.indobase.in

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
SUITE_TRAEFIK_RULE=Host(`workspace.indobase.in`) || Host(`suite.indobase.in`) || Host(`workspace.indobase.fun`)

DOCUMENT_SERVER_IMAGE_TAG=8.3.1
SUITE_VERSION=dev

# ── Indobase Meet (preferred: indobase-meet/docker/deploy) ──
# Workspace Meetings module SSO-launches Meet (aud=indobase-meet).
# Set the same MEET_HANDOFF_SECRET on Studio + Meet + (optionally) Workspace.
MEET_PUBLIC_URL=https://meet.indobase.in
MEET_HANDOFF_SECRET=
# Legacy alias still read by bridge:
# MEETINGS_PUBLIC_URL=https://meet.indobase.in
MEETINGS_TRAEFIK_RULE=Host(`meet.indobase.in`) || Host(`meet.indobase.fun`)
# Engine JWT / XMPP passwords live in indobase-meet/.env (or legacy docker-compose.meetings.yml)
JWT_APP_ID=indobase_meet
JWT_APP_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
JVB_PORT=10000
JVB_ADVERTISE_IPS=103.190.92.249
TZ=UTC

# ── Indobase Calendar (preferred: indobase-calendar/docker/deploy) ──
# Workspace Calendar module SSO-launches Calendar (aud=indobase-calendar).
# Set the same CALENDAR_HANDOFF_SECRET on Studio + Calendar + (optionally) Workspace.
CALENDAR_PUBLIC_URL=https://calendar.indobase.in
CALENDAR_HANDOFF_SECRET=
# Legacy engine-only compose: docker-compose.calendar.yml (superseded by indobase-calendar/)
CALENDAR_TRAEFIK_RULE=Host(`calendar.indobase.in`) || Host(`calendar.indobase.fun`)
CALENDAR_IMAGE=calcom/cal.diy:latest
CALENDAR_POSTGRES_USER=indobase_calendar
CALENDAR_POSTGRES_PASSWORD=
CALENDAR_POSTGRES_DB=indobase_calendar
# openssl rand -base64 32
CALENDAR_NEXTAUTH_SECRET=
# openssl rand -base64 24  (32 bytes for AES)
CALENDAR_ENCRYPTION_KEY=
CALENDAR_VAPID_PUBLIC_KEY=
CALENDAR_VAPID_PRIVATE_KEY=
