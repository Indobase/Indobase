# macOS resource forks (avoid xattr errors when building on Docker Desktop)
._*
**/._*

# VCS
.git
**/.git
.gitignore

# Node and build artifacts
node_modules
.pnpm-store

# Build outputs
**/dist
**/build
**/.next
**/.turbo

# IDE files
.vscode
.idea
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs

# Test files
**/*.test.*
**/*.spec.*
coverage

# Git
.git
.gitignore

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github

# Documentation
*.md
docs

# Temporary files
tmp
temp
*.tmp

# Environment files
.env*
!.env.example

# Package manager files
package-lock.json
yarn.lock

# Studio needs packages/ui/build (theme CSS) at build time — do not exclude
!packages/ui/build

# Ecosystem product stacks are deployed separately — keep them out of the Studio
# Docker context so GHA runners do not pack multi-GB bridge trees into buildx.
indobase-meet/
indobase-calendar/
indobase-suite/
indobase-discuss/
indobase-crm/
indobase-domains/
indobase-payments/
indobase-email/
indobase-social/
indobase-design/
indobase-design-v2/
indobase-video/
indobase-analytics/
# indobase-builder/ must stay in context — Builder image builds from monorepo root
# (needs packages/platform + indobase-builder via indobase-builder/Dockerfile).

