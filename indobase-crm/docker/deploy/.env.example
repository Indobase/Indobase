# Indobase CRM — copy to .env and fill secrets (never commit .env)

PG_DATABASE_NAME=default
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=change-me-postgres

# Twenty application secret (>= 32 chars). openssl rand -base64 32
TWENTY_APP_SECRET=

# Twenty at-rest encryption key (required for new installs). openssl rand -base64 32
# Losing this key loses access to OAuth tokens / encrypted secrets in the CRM DB.
TWENTY_ENCRYPTION_KEY=

# Shared with Studio (>= 32 chars). Same as STUDIO_HANDOFF_SECRET / CRM_HANDOFF_SECRET on control-plane.
CRM_HANDOFF_SECRET=

STUDIO_PUBLIC_URL=https://studio.indobase.in
CRM_PUBLIC_URL=https://crm.indobase.in

# Multi-tenant: one Twenty workspace per Indobase organization.
# Bridge creates workspaces on first SSO and stores invite hashes in the bridge volume
# (CRM_WORKSPACE_MAP_PATH=/var/lib/indobase-crm/workspace-map.json). Keep create enabled.
TWENTY_ALLOW_BOOTSTRAP_WORKSPACE=true
# Optional: legacy single-workspace invite hash. Only used when the org map is empty
# (claims that workspace for the first org that opens CRM). Leave blank for fresh installs.
TWENTY_WORKSPACE_INVITE_HASH=
TWENTY_DEFAULT_SUBDOMAIN=app

TWENTY_TAG=latest
CRM_VERSION=dev
GIT_SHA=dev

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
CRM_TRAEFIK_RULE=Host(`crm.indobase.in`)
