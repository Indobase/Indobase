# Indobase Payments Deploy Configuration
# Copy this file to .env and configure the values below.
# For production: use docker-compose.prod.yml with the same .env.

## Required Secrets (change these in every environment!)
JWT_SECRET=changeMeToASecureRandomString
INTERNAL_API_SECRET=changeMeToASecureRandomString
# Must be exactly 32 characters
SECRETS_CRYPT_KEY=00000000000000000000000000000000

## Database
DATABASE_USER=meteroid
DATABASE_PASSWORD=changeMeToASecurePassword
DATABASE_NAME=meteroid

## ClickHouse
CLICKHOUSE_DATABASE=meteroid
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=changeMeClickhousePassword
CLICKHOUSE_CLUSTER_NAME=meteroid

## Kafka
KAFKA_RAW_TOPIC=meteroid-events-raw

## Object Storage (default: filesystem with persistent volume; prefer S3 in prod)
# OBJECT_STORE_URI=file:///data/object-store
# OBJECT_STORE_URI=s3://indobase-payments
# AWS_ALLOW_HTTP=false
# AWS_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

## Public URLs
# Local / compose.dev:
# VITE_METEROID_API_EXTERNAL_URL=http://localhost:50061
# VITE_METEROID_REST_API_EXTERNAL_URL=http://localhost:8084
# METEROID_PUBLIC_URL=http://localhost:3000
#
# Production (Traefik on Vyom .249 or dedicated host):
VITE_METEROID_API_EXTERNAL_URL=https://api.payments.indobase.in
VITE_METEROID_REST_API_EXTERNAL_URL=https://api.payments.indobase.in
METEROID_PUBLIC_URL=https://payments.indobase.in
PAYMENTS_WEB_HOST=payments.indobase.in
PAYMENTS_API_HOST=api.payments.indobase.in

## Traefik (prod compose — Vyom .249 dokploy-traefik)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

## Optional: Indobase-built images (after CI / local build)
# INDOBASE_PAYMENTS_WEB_IMAGE=roshanraghavander/indobase-payments-web:<sha>
# INDOBASE_PAYMENTS_API_IMAGE=ghcr.io/meteroid-oss/meteroid-api:sha-80512c2
# INDOBASE_PAYMENTS_SCHEDULER_IMAGE=ghcr.io/meteroid-oss/meteroid-scheduler:sha-80512c2
# INDOBASE_PAYMENTS_METERING_IMAGE=ghcr.io/meteroid-oss/metering-api:sha-80512c2

## Multi-organization mode
ENABLE_MULTI_ORGANIZATION=false

## Optional: Webhooks via Svix
# SVIX_SERVER_URL=http://svix-server:8071
# SVIX_JWT_TOKEN=

## Optional: OAuth
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

## Optional: SMTP Mail
# MAILER_SMTP_HOST=smtp.example.com
# MAILER_SMTP_USERNAME=
# MAILER_SMTP_PASSWORD=
# MAILER_SMTP_TLS=true
MAILER_FROM=Indobase Payments <payments@indobase.in>

## Optional: Telemetry (OpenTelemetry)
TELEMETRY_TRACING_ENABLED=false
TELEMETRY_METRICS_ENABLED=false
# TELEMETRY_OTEL_ENDPOINT=http://otel-collector:4317
