    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/webfontloader": "^1.6.38",
    "concurrently": "^9.0.0",
    "tailwindcss": "^4.2.2",
