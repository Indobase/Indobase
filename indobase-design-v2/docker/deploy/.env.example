# Indobase Design v2 — deploy env (staging: studio-design.indobase.fun)

# MUST equal Studio's DESIGN_HANDOFF_SECRET (Studio signs the handoff with it).
# For Hostinger staging Studio, reuse /opt/indobase-staging/env/handoff.secret.
DESIGN_HANDOFF_SECRET=

# Where unauthenticated visitors are sent to sign in.
STUDIO_URL=https://studio.indobase.fun

DB_USER=design
DB_PASSWORD=
DB_NAME=design

DESIGN_VERSION=0.1.0
DESIGN_DB_POOL_MAX=10

# Traefik (Dokploy on Vyom .249)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
DESIGN_V2_TRAEFIK_RULE=Host(`studio-design.indobase.fun`)
