# Indobase Design (Canva-class) — deploy env on Vyom .249
#
# MUST equal Studio's DESIGN_HANDOFF_SECRET (Studio signs the handoff with it).
# Prod Swarm Studio and this stack share one secret. Staging Hostinger Studio
# DESIGN_HANDOFF_SECRET must match this value too (design handoff only).
DESIGN_HANDOFF_SECRET=

# Where unauthenticated visitors are sent to sign in.
STUDIO_URL=https://studio.indobase.in

DB_USER=design
DB_PASSWORD=
DB_NAME=design

# Prefer git SHA for reproducible rollouts (docker compose build tags the image).
DESIGN_VERSION=0.1.0
DESIGN_DB_POOL_MAX=10

# Optional Openverse app credentials for higher stock-search rate limits.
# Anonymous search works without these (register at https://api.openverse.org/v1/).
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=
# OPENVERSE_API_BASE=https://api.openverse.org/v1

# Traefik (Dokploy on Vyom .249)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
DESIGN_V2_TRAEFIK_RULE=Host(`design.indobase.in`) || Host(`design.indobase.fun`) || Host(`studio-design.indobase.fun`)

# Optional Sentry (leave empty to disable)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
