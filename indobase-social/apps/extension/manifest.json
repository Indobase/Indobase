{
  "manifest_version": 3,
  "name": "Indobase Social",
  "version": "2.0.0",
  "description": "Indobase Social browser extension for social media scheduling",
  "icons": {
    "32": "icon-32.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "cookies",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "*://*.skool.com/*",
    "https://social.indobase.in/*",
    "https://*.indobase.in/*",
    "https://social.indobase.fun/*",
    "https://*.indobase.fun/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://localhost/*",
      "https://*.indobase.in/*",
      "https://*.indobase.fun/*"
    ]
  }
}
