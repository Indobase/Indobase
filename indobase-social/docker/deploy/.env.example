# Indobase Social deploy env (copy to .env on the host)
# Docs: docs/INDOBASE-SOCIAL.md

DB_USER=social
DB_PASSWORD=change-me-strong-password
POSTGRES_DB=social

JWT_SECRET=change-me-openssl-rand-base64-32
STUDIO_HANDOFF_SECRET=change-me-same-as-studio-social-handoff-secret-32chars
SOCIAL_HANDOFF_SECRET=
STUDIO_PUBLIC_URL=https://studio.indobase.in
# When the same stack serves social.indobase.fun and social.indobase.in, Studio redirects
# are chosen from the request host (.fun → studio.indobase.fun, .in → STUDIO_PUBLIC_URL).
STUDIO_HANDOFF_ONLY=true
# Exposed to the browser so /auth/login never renders a password form in production.
NEXT_PUBLIC_STUDIO_HANDOFF_ONLY=true

MAIN_URL=https://social.indobase.in
FRONTEND_URL=https://social.indobase.in
NEXT_PUBLIC_BACKEND_URL=https://social.indobase.in/api

SOCIAL_HOST=social.indobase.in
SOCIAL_TRAEFIK_RULE=Host(`social.indobase.fun`) || Host(`social.indobase.in`)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Required: SHA-pinned Hub image from CI
INDOBASE_SOCIAL_IMAGE=roshanraghavander/indobase-social:REPLACE_WITH_GIT_SHA

TEMPORAL_DB_PASSWORD=temporal
STORAGE_PROVIDER=local
API_LIMIT=30
COOKIE_HOST_ONLY=true

# Optional social OAuth (leave empty to hide those channels from Connect)
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Sentry (Indobase org — project: social)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
