# Indobase Meet — copy to .env and fill secrets (never commit .env)

# Shared with Studio (>= 32 chars). Same as STUDIO_HANDOFF_SECRET on control-plane.
MEET_HANDOFF_SECRET=

STUDIO_PUBLIC_URL=https://studio.indobase.in
# STUDIO_PUBLIC_URL=https://studio.indobase.fun

MEET_PUBLIC_URL=https://meet.indobase.in
# MEET_PUBLIC_URL=https://meet.indobase.fun

MEET_IMAGE_VERSION=stable-10078
MEET_ENABLE_AUTH=1
MEET_AUTH_TYPE=jwt
MEET_ENABLE_GUESTS=0
JWT_ALLOW_EMPTY=0

# Shared by Prosody + bridge (mint room JWTs). Run ./gen-meet-passwords.sh
JWT_APP_ID=indobase_meet
JWT_APP_SECRET=
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=

JVB_PORT=10000
# Public IPv4 of Vyom .249 (or staging host) so ICE candidates work behind NAT
JVB_ADVERTISE_IPS=103.190.92.249
TZ=UTC

MEET_VERSION=dev
GIT_SHA=dev

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
MEET_TRAEFIK_RULE=Host(`meet.indobase.in`) || Host(`meet.indobase.fun`)
