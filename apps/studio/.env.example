# Indobase Studio — local development env file
# Copy to apps/studio/.env and fill in real values (NEVER commit the real one).
#
# When running Studio inside the docker compose stack you usually do NOT need
# this file at all — `docker/docker-compose.yml` already sets these vars on
# the `studio` service. Use this only for `pnpm -C apps/studio dev` against a
# running stack.

# --- Mode -----------------------------------------------------------------
# Indobase SaaS dashboard (orgs, billing, /api/platform/*). Default on unless NEXT_PUBLIC_INDOBASE_SAAS=false.
NEXT_PUBLIC_INDOBASE_SAAS=true

# --- Public URLs (browser-visible) ---------------------------------------
# These are inlined into the JS bundle at build time; if you change them you
# must rebuild Studio. When running in compose they're picked up at runtime
# only by server-side code paths.
# Production examples: NEXT_PUBLIC_SITE_URL=https://studio.indobase.in and
# NEXT_PUBLIC_SUPABASE_URL=https://api.indobase.in
SUPABASE_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_SITE_URL=https://studio.example.com
NEXT_PUBLIC_SUPABASE_URL=https://api.example.com
NEXT_PUBLIC_GOTRUE_URL=https://api.example.com/auth/v1
NEXT_PUBLIC_API_URL=https://api.example.com
# Optional hosted Builder UI used by the project experience chooser.
NEXT_PUBLIC_BUILDER_APP_URL=https://builder.example.com
# Indobase Payments app (Meteroid-derived AGPL engine). Studio /payments deep-links here.
NEXT_PUBLIC_INDOBASE_PAYMENTS_URL=https://payments.indobase.in

# --- API keys (must match the JWTs your Kong/GoTrue actually accepts) ----
NEXT_PUBLIC_ANON_KEY=replace-with-anon-jwt
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-jwt
SUPABASE_ANON_KEY=replace-with-anon-jwt
SUPABASE_SERVICE_KEY=replace-with-service-role-jwt
AUTH_JWT_SECRET=replace-with-the-same-jwt-secret-as-gotrue
JWT_SECRET=replace-with-the-same-jwt-secret-as-gotrue
# Optional explicit secret for signing Studio -> Builder handoff tokens.
BUILDER_HANDOFF_SECRET=replace-with-a-32-char-min-secret
# Studio → Indobase Calendar SSO (same value as Calendar CALENDAR_HANDOFF_SECRET /
# STUDIO_HANDOFF_SECRET, ≥32 chars).
# CALENDAR_HANDOFF_SECRET=replace-with-a-32-char-min-secret
# NEXT_PUBLIC_INDOBASE_CALENDAR_URL=https://calendar.indobase.in
# INDOBASE_CALENDAR_URL=https://calendar.indobase.in
# Studio → Indobase Meet SSO (same value as Meet MEET_HANDOFF_SECRET, ≥32 chars).
# MEET_HANDOFF_SECRET=replace-with-a-32-char-min-secret
# NEXT_PUBLIC_INDOBASE_MEET_URL=https://meet.indobase.in
# INDOBASE_MEET_URL=https://meet.indobase.in
# Studio → Indobase Payments SSO (same value as Payments STUDIO_HANDOFF_SECRET /
# PAYMENTS_HANDOFF_SECRET, ≥32 chars). Falls back to BUILDER_HANDOFF_SECRET if unset.
# PAYMENTS_HANDOFF_SECRET=replace-with-a-32-char-min-secret
# Public Payments web URL used by /project/[ref]/payments launch.
# NEXT_PUBLIC_INDOBASE_PAYMENTS_URL=https://payments.indobase.in
# INDOBASE_PAYMENTS_URL=https://payments.indobase.in

# --- In-network URLs (server-side only) ----------------------------------
SUPABASE_URL=http://indobase-kong:8000
GOTRUE_URL=http://indobase-kong:8000/auth/v1
KONG_INTERNAL_GOTRUE_URL=http://indobase-kong:8000/auth/v1
STUDIO_PG_META_URL=http://indobase-meta:8080

# --- pg-meta encryption (must match meta's CRYPTO_KEY) -------------------
PG_META_CRYPTO_KEY=replace-with-32-byte-base64-key
CRYPTO_KEY=replace-with-32-byte-base64-key

# --- Postgres (control-plane DB for SaaS metadata + pg-meta queries) -----
POSTGRES_HOST=indobase-db
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
# Must be the same DB role as POSTGRES_PASSWORD (defaults to POSTGRES_USER).
# Only set to supabase_admin if that role exists and uses this password.
POSTGRES_USER_READ_WRITE=postgres
POSTGRES_USER_READ_ONLY=supabase_read_only_user

# --- Defaults shown in onboarding ----------------------------------------
DEFAULT_ORGANIZATION_NAME=Default Organization
DEFAULT_PROJECT_NAME=Default Project

# --- Optional: tenant pooler (Supavisor-style) for Connect / pooling UI ----
# When set, tenant-stack includes `tenant_pooler` and Supavisor config adds a
# second row with a `postgresql://postgres.<ref>@<host>:<port>/<db>` URI (no password).
# SAAS_TENANT_POOLER_HOST=pooler.yourinfra.internal
# SAAS_TENANT_POOLER_PORT=6543

# --- SaaS: database isolation (dedicated DB is the only safe default) ---------
# When false, auth.users listing will not auto-provision a dedicated database.
# Default: auto-provision on first auth.users query and from the Auth Users screen.
# SAAS_AUTO_PROVISION_DEDICATED_ON_AUTH_USERS=false
# Per-project DB on create (default true). Shared Model A requires BOTH of:
#   SAAS_DEDICATED_DATABASE_ON_PROJECT_CREATE=false
#   SAAS_ALLOW_SHARED_DATABASE_TENANCY=true
# SAAS_DEDICATED_DATABASE_ON_PROJECT_CREATE=true
# SAAS_ALLOW_SHARED_DATABASE_TENANCY=false

# --- Optional: embed Supavisor in generated tenant docker-compose ------------
# When true, Studio adds tenant-pooler (supabase/supavisor) on 127.0.0.1:<data_plane_port_base+6>:6543
# and a compose `configs` block with pooler.exs. Requires tenant DB bootstrap (Repair DB bootstrap)
# to install pgbouncer.get_auth when possible.
# SAAS_TENANT_EMBED_SUPAVISOR=true

# --- PostHog (product analytics + feature flags) ---------------------------
# Project API key from PostHog → Project settings. When unset, Studio uses
# built-in SaaS feature-flag defaults and does not send analytics.
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Ingest host (US default). EU example: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# App UI host for session links / toolbar. EU example: https://eu.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
#
# Error-tracking source maps (CI only — personal API key, never commit):
# POSTHOG_CLI_API_KEY=phx_...
# POSTHOG_CLI_PROJECT_ID=12345
# POSTHOG_CLI_HOST=https://us.posthog.com
# See docs/POSTHOG-ERROR-TRACKING.md

# --- E2E: opt-in tenant PostgREST probe (see e2e/studio/features/tenant-rest-health.spec.ts)
# E2E_TENANT_REST_URL=https://<ref>.<public-domain>/rest/v1
# E2E_TENANT_ANON_KEY=<anon JWT for that project>
