# Example environment variables for Studio (do NOT commit secrets here)

# Local services
STUDIO_PG_META_URL=http://localhost:8000/pg
POSTGRES_PASSWORD=changeme_replace_with_secure_password

# Defaults
DEFAULT_ORGANIZATION_NAME=Default Organization
DEFAULT_PROJECT_NAME=Default Project
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password

# Supabase/Indobase endpoints (change for self-hosting)
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Indobase aliases
INDOBASE_URL=$SUPABASE_URL
INDOBASE_PUBLIC_URL=$SUPABASE_PUBLIC_URL
INDOBASE_ANON_KEY=$SUPABASE_ANON_KEY
INDOBASE_SERVICE_KEY=$SUPABASE_SERVICE_KEY

# Logging / Sentry
SENTRY_IGNORE_API_RESOLUTION_ERROR=1
LOGFLARE_URL=http://localhost:4000
LOGFLARE_PRIVATE_ACCESS_TOKEN=replace_with_token

# Next.js runtime/public variables
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOTRUE_URL=$INDOBASE_PUBLIC_URL/auth/v1
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=replace_with_site_key

# CmdK / AI
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace_with_anon_key
NEXT_PUBLIC_SUPABASE_URL=https://your.supabase.instance
NEXT_PUBLIC_INDOBASE_URL=$NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_INDOBASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY

# Docker
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Next.js Base Path for Proxy
NEXT_PUBLIC_BASE_PATH=/dashboard

# Note: For production, use a secure secret manager and do NOT store secrets in git.
