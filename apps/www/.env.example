# --- Indobase wiring ---
# Console / Studio URL. "Start building" CTAs link to this base + /sign-up
PUBLIC_APPWRITE_DASHBOARD=https://studio.indobase.in
# Alternative: PUBLIC_INDOBASE_CONSOLE_URL

# Builder URL for marketing prompt → build deep links (default: https://builder.indobase.in)
PUBLIC_BUILDER_URL=https://builder.indobase.in

# Backend API. Production: api.indobase.in. Local: your backend URL
PUBLIC_APPWRITE_ENDPOINT=https://api.indobase.in/v1
PUBLIC_APPWRITE_PROJECT_ID=demo

# --- Appwrite/legacy (optional) ---
PUBLIC_APPWRITE_COL_MESSAGES_ID=
PUBLIC_APPWRITE_COL_THREADS_ID=
PUBLIC_APPWRITE_DB_MAIN_ID=
PUBLIC_APPWRITE_FN_TLDR_ID=
PUBLIC_APPWRITE_PROJECT_INIT_ID=
PUBLIC_GROWTH_ENDPOINT=
# PostHog product analytics (marketing site). When unset, pageviews/events are not sent.
PUBLIC_POSTHOG_API_KEY=
# Ingest host (US default). EU example: https://eu.i.posthog.com
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# App UI host for session links. EU example: https://eu.posthog.com
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Source map upload (CI only): POSTHOG_CLI_API_KEY, POSTHOG_CLI_PROJECT_ID — docs/POSTHOG-ERROR-TRACKING.md
APPWRITE_DB_INIT_ID=
APPWRITE_COL_INIT_ID=
APPWRITE_API_KEY_INIT=
# Sentry (Indobase org — project: website). Prefer PUBLIC_ for browser; SENTRY_DSN for server.
# PUBLIC_SENTRY_DSN=https://...@o....ingest.us.sentry.io/...
# SENTRY_DSN=
# PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_AUTH_TOKEN=

