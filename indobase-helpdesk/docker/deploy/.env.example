# Indobase Helpdesk — copy to .env and fill secrets (never commit .env)

MARIADB_ROOT_PASSWORD=change-me-mariadb-root
HELPDESK_ADMIN_PASSWORD=change-me-admin

# Shared with Studio (>= 32 chars). Same as STUDIO_HANDOFF_SECRET on control-plane.
HELPDESK_HANDOFF_SECRET=

STUDIO_PUBLIC_URL=https://studio.indobase.in
# STUDIO_PUBLIC_URL=https://studio.indobase.fun

HELPDESK_SITE_NAME=helpdesk.localhost
HELPDESK_VERSION=dev

TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
HELPDESK_TRAEFIK_RULE=Host(`helpdesk.indobase.in`) || Host(`helpdesk.indobase.fun`)
