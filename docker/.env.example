############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
DASHBOARD_USERNAME=indobase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
VAULT_ENC_KEY=your-32-character-encryption-key
# Split deploy (Studio = separate Dokploy app): publish postgres-meta on host for Studio to reach
# PG_META_PUBLISH_PORT=8081

# Quote if the value contains + or = (otherwise .env parsers may corrupt it → postgres-meta Unauthorized)
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min


############
# Database - You can change these to any PostgreSQL database that has logical replication enabled.
############

POSTGRES_HOST=indobase-db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres
# Optional: override DB users passed to Studio for platform APIs (defaults: supabase_admin / supabase_read_only_user)
# POSTGRES_USER_READ_WRITE=supabase_admin
# POSTGRES_USER_READ_ONLY=supabase_read_only_user


############
# Supavisor -- Database pooler
############
# Port Supavisor listens on for transaction pooling connections
POOLER_PROXY_PORT_TRANSACTION=6543
# Maximum number of PostgreSQL connections Supavisor opens per pool
POOLER_DEFAULT_POOL_SIZE=20
# Maximum number of client connections Supavisor accepts per pool
POOLER_MAX_CLIENT_CONN=100
# Unique tenant identifier
POOLER_TENANT_ID=your-tenant-id
# Pool size for internal metadata storage used by Supavisor
# This is separate from client connections and used only by Supavisor itself
POOLER_DB_POOL_SIZE=5


############
# API Proxy - Configuration for the Kong Reverse proxy.
############

KONG_HTTP_PORT=8082
KONG_HTTPS_PORT=8443


############
# API - Configuration for PostgREST.
############

PGRST_DB_SCHEMAS=public,storage,graphql_public


############
# Auth - Configuration for the GoTrue authentication server.
############

## General
# Production SaaS: set SITE_URL to the public Studio/dashboard URL (same idea as NEXT_PUBLIC_SITE_URL).
# Example: https://studio.indobase.in
# Local stack default: Kong is exposed on host port 8082 (`KONG_HTTP_PORT`), while :8000 is container-internal.
SITE_URL=http://localhost:8082
# Comma-separated OAuth/email redirect allow-list (production hosts).
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
# Refresh token rotation (revokes reused/old tokens; reuse interval in seconds)
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=10
GOTRUE_SECURITY_REFRESH_TOKEN_ALLOW_REUSE=false
GOTRUE_SECURITY_REFRESH_TOKEN_ALGORITHM_VERSION=2
GOTRUE_SECURITY_REFRESH_TOKEN_UPGRADE_PERCENTAGE=100
# Brute-force lockout (requires docker/volumes/db/migrations/20260517120000_auth_password_lockout_hook.sql)
GOTRUE_HOOK_PASSWORD_VERIFICATION_ATTEMPT_ENABLED=true
DISABLE_SIGNUP=false
# IMPORTANT: In production, set this to your public API base URL (e.g. https://api.indobase.in).
# Do NOT append /auth/v1 — GoTrue appends auth paths internally.
# Wrong: https://api.indobase.in/auth/v1
# Right: https://api.indobase.in
API_EXTERNAL_URL=http://localhost:8082

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
# Control-plane Studio: recovery links must hit /auth/confirm on the Studio host (not /auth/v1/verify).
MAILER_URLPATHS_RECOVERY="/auth/confirm"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
MAILER_OTP_LENGTH=6
MAILER_OTP_EXP=3600
MAILER_TEMPLATES_RECOVERY="/auth/recovery-email.html"

## Email auth
ENABLE_EMAIL_SIGNUP=true
# Set true for fastest onboarding (skip inbox confirmation; users can sign in immediately after sign-up).
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=indobase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## OAuth (control-plane GoTrue — set secrets only on VPS .env, never commit)
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_SECRET=
# Register redirect URL in provider consoles: ${API_EXTERNAL_URL}/auth/v1/callback
# Production: https://api.indobase.in/auth/v1/callback

## Production SMTP (e.g. Resend) — replace Inbucket defaults for real delivery
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxx
# SMTP_ADMIN_EMAIL=auth@your-verified-domain.com
# SMTP_SENDER_NAME=Indobase

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true


############
# Studio - Configuration for the Dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

# Public API URL for browsers; internal Docker services still use http://indobase-kong:8000 inside compose.
# Production example: https://api.indobase.in
SUPABASE_PUBLIC_URL=http://localhost:8082

############
# SaaS-ready Studio (custom Indobase image from this repo)
############
# Org/team/billing routes (default on unless set to the string "false").
NEXT_PUBLIC_INDOBASE_SAAS=true
# Studio origin users visit in browser.
# Production example: https://studio.indobase.in
NEXT_PUBLIC_SITE_URL=http://localhost:8082
# Public API gateway origin for browser clients (Kong host port).
# Production example: https://api.indobase.in
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8082
# Optional: defaults to ANON_KEY in docker-compose if empty.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_DOCS_URL=https://indobase.in/docs
# ind-repo Studio: STUDIO_DOCKER_IMAGE=ghcr.io/you/indobase-studio:latest
STUDIO_DOCKER_IMAGE=indobase/studio:latest
# Port Next.js listens on inside the Studio container (compose healthcheck uses this).
# Indobase image from this repo: 8080. Upstream `supabase/studio` images often use 3000 — set STUDIO_PORT=3000 if you keep the upstream default image.
# STUDIO_PORT=8080
# Optional: proxy `/api/v1/projects/:ref/branches` to an external branching API (Supabase-compatible).
# When unset, Studio provisions preview branches as dedicated tenant databases (Indobase SaaS).
# BRANCHING_PLATFORM_API_URL=https://branching-control.example.com/api
# SAAS_BRANCHING_ENABLED=true

# --- Per-project Postgres (default ON for Indobase SaaS Studio) ---
# When true (default), each new Studio project provisions a dedicated database + role on the
# same cluster as POSTGRES_HOST (see apps/studio/lib/api/saas/provision-tenant-db.ts).
# Set to "false" for legacy Model A: one shared POSTGRES_DB + RLS / project_ref on the gateway.
# SAAS_DEDICATED_DATABASE_ON_PROJECT_CREATE=true
# Optional superuser for CREATE DATABASE (defaults to POSTGRES_USER_READ_WRITE in compose).
# SAAS_TENANT_PROVISION_ADMIN_USER=postgres
#
# Per-project data plane (PostgREST + GoTrue on host ports; Traefik via provisioner):
# SAAS_PUBLIC_DOMAIN=studio.example.com   # used for ref.<domain> URLs (fallback: hostname from NEXT_PUBLIC_SUPABASE_URL)
# SAAS_DOCKER_NETWORK_NAME=indobase_default   # Docker network tenant stacks join to reach POSTGRES_HOST
# DATA_PLANE_PROVISIONER_URL=http://indobase-data-plane-provisioner:8787
# DATA_PLANE_PROVISIONER_TOKEN=change-me
# Optional: same password for authenticator + supabase_* DB roles (otherwise they match the tenant role password).
# SAAS_DATA_PLANE_AUX_ROLE_PASSWORD=
# Host path to edge function sources for tenant stacks (otherwise an empty named Docker volume is used).
# SAAS_TENANT_FUNCTIONS_HOST_PATH=/path/to/docker/volumes/functions
#
# Tenant data plane tuning (see docker/docs/TENANT_DATA_PLANE_TUNING.md, SCALING_CHECKLIST.md):
# SAAS_TENANT_POSTGREST_DB_POOL=64
# SAAS_TENANT_POSTGREST_POOL_ACQUISITION_TIMEOUT=20
# SAAS_TENANT_POSTGREST_POOL_MAX_IDLETIME=180
# SAAS_TENANT_POSTGREST_DB_MAX_ROWS=0
# SAAS_TENANT_POSTGREST_MEM_LIMIT=768m
# SAAS_TENANT_EDGE_RUNTIME_MEM_LIMIT=768m
# SAAS_TENANT_REALTIME_RLIMIT_NOFILE=100000
# SAAS_TENANT_REALTIME_DB_POOL_SIZE=32
# SAAS_TENANT_STORAGE_FILE_SIZE_LIMIT_BYTES=10737418240
# SAAS_TENANT_IMGPROXY_DOWNLOAD_BUFFER_BYTES=2097152
# SAAS_TENANT_IMGPROXY_DOWNLOAD_TIMEOUT_SECONDS=60
# SAAS_TENANT_POOLER_MAX_CLIENT_CONN=800
#
# Billing list prices (INR) without code changes — closes mid-market vs per-project SaaS:
# INDOBASE_PRO_PLAN_PRICE_INR=2499
# INDOBASE_TEAM_PLAN_PRICE_INR=17999

# --- Platform APIs (/api/platform/profile, /organizations, etc.) ---
# Studio talks to Postgres through postgres-meta. These MUST stay in sync with the `meta` service:
#
#   STUDIO_PG_META_URL=http://meta:8080
#     (inside compose; or http://kong:8000/pg if you route via Kong — Kong /pg requires service_role apikey)
#
#   PG_META_CRYPTO_KEY — same value as CRYPTO_KEY on the `meta` container (see docker-compose.yml).
#
#   POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB, POSTGRES_PASSWORD — same DB as PG_META_DB_* / stack Postgres.
#   Optional: POSTGRES_USER_READ_WRITE (default supabase_admin), POSTGRES_USER_READ_ONLY (default supabase_read_only_user).
#
# Passwords with @ : ; / etc. are OK; Studio URI-encodes them when calling pg-meta.

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Add your OpenAI API key to enable SQL Editor Assistant
OPENAI_API_KEY=


############
# Functions - Configuration for Functions
############
# NOTE: VERIFY_JWT applies to all functions. Per-function VERIFY_JWT is not supported yet.
# Security default: keep this true. Only set false for intentionally public functions.
FUNCTIONS_VERIFY_JWT=true


############
# Logs - Configuration for Analytics
# Please refer to https://indobase.in/docs/reference/self-hosting-analytics/introduction
############

# Change vector.toml sinks to reflect this change
# these cannot be the same value
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER

############
# Storage - Configuration for the storage
############

STORAGE_TENANT_ID=stub
GLOBAL_S3_BUCKET=stub
REGION=stub
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907

# Used in docker-compose.s3.yml for minio
MINIO_ROOT_USER=supa-storage
MINIO_ROOT_PASSWORD=secret1234
