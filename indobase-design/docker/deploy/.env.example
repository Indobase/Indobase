# Indobase Design deploy env — copy to .env and fill in.
# See docs/INDOBASE-DESIGN.md for the full runbook.

# Upstream Penpot engine version (SHA-equivalent pin; bump deliberately).
PENPOT_VERSION=2.17.0

# Public URLs
DESIGN_PUBLIC_URL=https://design.indobase.in
STUDIO_PUBLIC_URL=https://studio.indobase.in

# Shared HMAC secret with Studio (same value as Studio DESIGN_HANDOFF_SECRET;
# reuse the Email/Social STUDIO_HANDOFF_SECRET). >= 32 chars.
DESIGN_HANDOFF_SECRET=

# OIDC bridge (shim <-> Penpot backend). Generate:
#   openssl rand -base64 48 | tr -d '/+=' | head -c 48
OIDC_CLIENT_ID=indobase-studio
OIDC_CLIENT_SECRET=

# Penpot master key. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Database
DB_USER=penpot
DB_PASSWORD=

# Traefik (Dokploy defaults on Vyom .249)
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
DESIGN_TRAEFIK_RULE=Host(`design.indobase.in`) || Host(`design.indobase.fun`)
